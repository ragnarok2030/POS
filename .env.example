# SumUp is handled by the external serverless gateway.
# Keep all SumUp API credentials ONLY in Vercel (POS-Sumup).
SUMUP_GATEWAY_URL=https://pos-sumup.vercel.app

NEXT_PUBLIC_APP_URL=https://www.bendemen.com
WOOCOMMERCE_URL=https://www.bendemen.com
WOO_CONSUMER_KEY=
WOO_CONSUMER_SECRET=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=bendemen_pos
# Only on the shop VPS, when WooCommerce traffic must leave from one address.
# Leave this empty on any other machine.
# WOOCOMMERCE_LOCAL_ADDRESS=45.135.148.12
# Set a long random JWT_SECRET for signed POS sessions. If blank, the server uses a server-only secret fallback.
JWT_SECRET=
WOOCOMMERCE_KEY=
WOOCOMMERCE_SECRET=
NEXT_PUBLIC_WOOCOMMERCE_URL=https://www.bendemen.com
NEXT_PUBLIC_WOOCOMMERCE_KEY=
NEXT_PUBLIC_WOOCOMMERCE_SECRET=

# BDM POS Core REST API base. The code also accepts the bare site URL and adds this path.
# The matching secret must be configured in the BDM POS Core WordPress settings.
BDMPOS_CORE_URL=https://www.bendemen.com/wp-json/bdmpos/v1
BDMPOS_CORE_SECRET=
# queue: the WordPress plugin worker creates orders. Required on the shop server,
# because that server cannot open a connection to bendemen.com.
# direct: this machine calls the shop over HTTPS itself.
BDMPOS_CORE_TRANSPORT=queue


# Signed WooCommerce -> POS Core webhook delivery.
# Configure the same random secret in WordPress wp-config.php as BDMPOS_CORE_WEBHOOK_SECRET.
# The URL points to the POS server's webhook receiver (not to the WordPress site).
BDMPOS_CORE_WEBHOOK_SECRET=
